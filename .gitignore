#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Kotlin compiler session markers are local build cache, never source delivery.
/android/.kotlin/
/coverage/
.codex-artifacts/
.codex-backups/
.codex-temp/
.codex-*.png
.codex-*.xml
.impeccable/mocks/
.visual-reference-runtime/
test_artifacts/
assets/design-qa/
release/*.apk

# Local source archives and machine credentials are not part of a source snapshot.
/Mesting-Music-*-source.zip
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/key.properties
**/*.keystore
**/*.jks
**/local.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Beta.21 host screenshots; source and portable summaries remain separate.
/.impeccable/review/beta21/

# Local Cargo checks generate cache files, never product/source inputs.
/third_party/md3music/rust/target/
